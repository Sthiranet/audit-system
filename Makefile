# Sthiranet prototype: sthira-node (Rust CLI) + the Daml anchoring model on a Canton sandbox.
# The web demo lives on the `demo` branch.
SHELL := /bin/bash
.PHONY: gen node sandbox daml-test test test-unit check clean

LEDGER_URL ?= http://localhost:7575
SANDBOX_LOG := prototype-sandbox/log/make-test-sandbox.log

gen:                ## write the offline dummy change log (changes.jsonl, 200 MySQL binlog transactions)
	cargo run -q -p sthira-node -- gen --force

node:               ## build the prototype CLI (target/release/sthira-node)
	cargo build --release -p sthira-node

sandbox:            ## start the Canton sandbox with the sthiranet-audit DAR (JSON Ledger API on :7575)
	cd prototype-sandbox && ./sandbox.sh

daml-test:          ## run the Daml Script tests of the sthiranet-audit package
	cd prototype-sandbox && dpm test

test-unit:          ## the tests that need no ledger (hashing, connector, sealing, verifier)
	cargo test --workspace

test:               ## every test; the ledger ones run on a Canton sandbox (started and stopped here if none is up)
	@if curl -sf $(LEDGER_URL)/v2/version >/dev/null; then \
	  echo "using the sandbox already running at $(LEDGER_URL)"; \
	  STHIRA_CANTON_URL=$(LEDGER_URL) cargo test --workspace -- --include-ignored; \
	else \
	  mkdir -p prototype-sandbox/log; \
	  setsid bash -c 'cd prototype-sandbox && exec ./sandbox.sh' > $(SANDBOX_LOG) 2>&1 & pid=$$!; \
	  trap 'kill -- -$$pid 2>/dev/null; wait $$pid 2>/dev/null' EXIT; \
	  echo "starting the Canton sandbox (log: $(SANDBOX_LOG))"; \
	  for i in $$(seq 1 180); do \
	    curl -sf $(LEDGER_URL)/v2/state/connected-synchronizers 2>/dev/null | grep -q synchronizerId && break; \
	    kill -0 $$pid 2>/dev/null || { echo "the sandbox exited; see $(SANDBOX_LOG)"; exit 1; }; \
	    sleep 1; \
	  done; \
	  STHIRA_CANTON_URL=$(LEDGER_URL) cargo test --workspace -- --include-ignored; \
	fi

check:              ## formatting and lints, as CI would run them
	cargo fmt --all --check
	cargo clippy --workspace --all-targets -- -D warnings

clean:              ## delete everything compiled or generated by runs: build output, data directories, change logs, proofs
	cargo clean
	rm -rf prototype-sandbox/.daml prototype-sandbox/log ./sthira-data ./sthira-gap
	rm -f ./changes.jsonl ./proof.json
